<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <authentication-client xmlns="urn:elytron:client:1.7">
        <authentication-rules>
            <rule use-configuration="ciudadano-rule">
                <match-host name="localhost"/>
            </rule>
        </authentication-rules>
        <authentication-configurations>
            <configuration name="ciudadano-rule">
                <sasl-mechanism-selector selector="DIGEST-MD5"/>
                <set-user-name name="joaco"/>
                <credentials>
                    <clear-password password="joaco"/>
                </credentials>
            </configuration>
        </authentication-configurations>
    </authentication-client>
    <jboss-ejb-client xmlns="urn:jboss:wildfly-client-ejb:3.0">
        <connections>
            <connection uri="remote+http://localhost:8080"/>
        </connections>
    </jboss-ejb-client>
</configuration>
